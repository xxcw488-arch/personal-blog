node_modules/
dist/
.wrangler/
.wrangler-tmp/
.dev.vars
.env
.env.*
!.env.example
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
_recon/

# 接口验证脚手架的打包产物与生成的 XML（每次 verify:api 会重新生成）
site/.fn-check/run.bundle.mjs
site/.fn-check/out/

# 本地开发服务器的自动生成路由表
site/.fn-check/.devserver-routes.ts
site/.fn-check/.devserver-routes.mjs

# 一次性调试脚本（探针/截图/回归体检）：点开头命名，用完即删，不入库。
site/.*.mjs
site/.*.py

# 截图目录里**下划线开头**的一律不入库 —— 这类都是内部产物：
# 迭代过程的中间截图（_v1 / _before / _after / _prod / _final …）、
# 参考站抓取素材（_ref …）。只列具体命名一定会漏（_final-* 就是这么混进去的），
# 所以这里用一条通配兜住整个类别。
docs/screenshots/_*

# 参考站（第三方站点）的抓取数据：只用于本地比对，需要时重新抓一次。
docs/_ref-*.json

# 不属于博客项目本身的提示词 / 风格规范文档。
/UI-STYLE-PROMPT.md
/flare-stack-blog-aurora-prompt.md
/ui-style-rule.md

# 内部工作笔记，不随仓库发布。
docs/HANDOFF.md

# DSH 会话导出包（体积大，且不属于博客项目本身）
dsh-session-*.zip
