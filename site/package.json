{
  "name": "blog-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "公开站：Vue 3 + TS + Vite + Pinia + Cloudflare Pages Functions",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:functions": "tsc -p functions/tsconfig.json",
    "verify:api": "node .fn-check/verify.mjs",
    "dev:local": "npm run build && node .fn-check/devserver.mjs",
    "preview": "vite preview",
    "preview:cf": "wrangler pages dev dist"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "marked": "^15.0.6",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "sql.js": "^1.14.2",
    "typescript": "~5.7.3",
    "vite": "^6.0.11",
    "vue-tsc": "^2.2.0"
  }
}
